# VSHARES environment template.
# Copy to .env.local and fill in. Never commit a filled-in file.
# These variables belong to VSHARES only and are never shared with another project.

# Public site origin. Used for absolute URLs and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. For local development run `npm run db:start`; the CLI
# prints the API URL and the anon key to use here.
# Required from Milestone 2 onwards, when the database is first used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key with elevated privileges. Never exposed to the browser and
# never required for local UI work. Leave empty until a milestone needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Local end-to-end testing only: path to a preinstalled Chromium binary.
# Leave empty to use the browser Playwright manages itself.
PLAYWRIGHT_CHROMIUM_PATH=
